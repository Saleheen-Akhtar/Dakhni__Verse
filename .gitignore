# =============================================================================
# DAKHNI VERSE — Git Ignore Configuration
# =============================================================================
# Everything listed here will NOT be tracked or uploaded to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Sensitive Credentials & Environment Secrets (NEVER COMMIT!)
# -----------------------------------------------------------------------------
# Contains Supabase URLs, Anon Keys, and Service Role Keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example

# Private Keys, Certificates, and Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
credentials.json
service-account*.json
service_account*.json
supabase-keys*.json

# -----------------------------------------------------------------------------
# 2. Package Dependencies
# -----------------------------------------------------------------------------
# Downloaded packages should be installed freshly via 'npm install'
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# -----------------------------------------------------------------------------
# 3. Next.js Build Outputs & Caches
# -----------------------------------------------------------------------------
# Next.js Turbopack compilation and production bundle caches
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# 4. Logs & Debugging Files
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------------------------------------
# 5. Local Scratch & Temporary Files
# -----------------------------------------------------------------------------
scratch/
temp/
tmp/
*.tmp
*.temp
/coverage/
*.lcov
.nyc_output

# -----------------------------------------------------------------------------
# 6. Operating System Artifacts
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~

# -----------------------------------------------------------------------------
# 7. IDE & Code Editor Configurations
# -----------------------------------------------------------------------------
# Visual Studio Code (preserve team launch/settings if needed, ignore local state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (WebStorm, IntelliJ IDEA)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# 8. Hosting & Deployment Caches
# -----------------------------------------------------------------------------
.vercel
