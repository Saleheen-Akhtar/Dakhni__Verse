# DAKHNI VERSE — Environment Configuration Template
# Copy this file to .env.local and populate with your own project credentials:
#   cp .env.example .env.local

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key
# Required for server-side administrative actions (account generation, invite links, rate limit RPC bypass)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
